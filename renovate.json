{
  "extends": [
    "config:best-practices"
  ],
  "ignorePaths": [
    ".kokoro/requirements.txt"
  ],
  "packageRules": [
    {
      "groupName": "AppEngine packages",
      "matchPackageNames": [
        "/^com.google.appengine:appengine-/"
      ]
    },
    {
      "description": "Pin jdo2-api to 2.3-eb. Maven version ordering ranks 2.3-20090302111651 higher, but that build is older and its POM has no license.",
      "matchPackageNames": [
        "javax.jdo:jdo2-api"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "jakarta.servlet:jakarta.servlet-api"
      ],
      "groupName": "Jakarta servlet API",
      "enabled": false
    },
    {
      "versioning": "docker",
      "enabled": false,
      "matchPackageNames": [
        "/^com.google.guava:/"
      ]
    },
    {
      "groupName": "Protobuf dependencies",
      "enabled": false,
      "matchPackageNames": [
        "/^com.google.protobuf/"
      ]
    },
    {
      "groupName": "gRPC dependencies",
      "enabled": false,
      "matchPackageNames": [
        "/^io.grpc/"
      ]
    }
  ]
}
